# Smart Procurement Centre Operator Portal - Environment Configuration

# API Base URL (Leave empty or set to http://localhost:5000 for backend)
VITE_API_BASE_URL=http://localhost:5000

# WebSocket / Socket.IO URL
VITE_WS_URL=http://localhost:5000

# Enable Mock Data Service (set to 'false' when connecting to live backend API)
VITE_USE_MOCK_API=true

# Centre Default Info
VITE_CENTRE_NAME=Central APMC Procurement Hub - Centre #402
VITE_CENTRE_CODE=APMC-PB-402
